WEBMAN_STARTER_HTTP_PORT=8787
WEBMAN_STARTER_ROUTES_ENABLED=0
WEBMAN_STARTER_ROUTE_PREFIX=/saas

# Use the same MySQL settings for Webman, migrations and administrator initialization.
STARTER_DB_HOST=127.0.0.1
STARTER_DB_PORT=3306
STARTER_DB_DATABASE=
STARTER_DB_USERNAME=
STARTER_DB_PASSWORD=

# Set a unique product/environment prefix to configure Redis.
STARTER_REDIS_HOST=127.0.0.1
STARTER_REDIS_PORT=6379
STARTER_REDIS_PASSWORD=
STARTER_REDIS_PREFIX=

# To enable identity routes, configure a product:environment Redis prefix and a secret.
STARTER_AUTH_ENABLED=0
STARTER_AUTH_SECRET=
STARTER_SMS_ENABLED=1
STARTER_SMS_TEMPLATE_LOGIN=
STARTER_SMS_TEMPLATE_REBIND=
STARTER_SMS_TEMPLATE_ACCOUNT_SECURITY=
STARTER_SMS_INTERVAL=60
STARTER_SMS_PER_DAY=10
STARTER_SMS_PER_HOUR_PER_IP=20
STARTER_SMS_TTL=300
STARTER_SMS_ATTEMPTS=5
STARTER_TIMEZONE=Asia/Shanghai
STARTER_TRUSTED_PROXIES=

# Optional SMTP when email sign-in is offered.
STARTER_SMTP_DSN=
STARTER_EMAIL_FROM=
STARTER_EMAIL_INTERVAL=60
STARTER_EMAIL_PER_DAY=10
STARTER_EMAIL_PER_HOUR_PER_IP=20
STARTER_EMAIL_TTL=600
STARTER_EMAIL_ATTEMPTS=5

# Enable only for a controlled operations project with an evidence verifier configured in starter.php.
STARTER_OPERATOR_RECOVERY_CLI_ENABLED=0
