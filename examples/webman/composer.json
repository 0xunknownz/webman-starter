{
  "name": "z0x/webman-starter-example",
  "type": "project",
  "keywords": [
    "high performance",
    "http service"
  ],
  "homepage": "https://www.workerman.net",
  "license": "MIT",
  "description": "Local Webman example host for Webman Starter.",
  "authors": [
    {
      "name": "walkor",
      "email": "walkor@workerman.net",
      "homepage": "https://www.workerman.net",
      "role": "Developer"
    }
  ],
  "support": {
    "email": "walkor@workerman.net",
    "issues": "https://github.com/walkor/webman/issues",
    "forum": "https://wenda.workerman.net/",
    "wiki": "https://workerman.net/doc/webman",
    "source": "https://github.com/walkor/webman"
  },
  "require": {
    "php": ">=8.1",
    "workerman/webman-framework": "^2.1",
    "monolog/monolog": "^2.0",
    "z0x/webman-starter": "dev-local",
    "webman/database": "^2.1",
    "webman/redis": "^2.1"
  },
  "suggest": {
    "ext-event": "For better performance. "
  },
  "autoload": {
    "psr-4": {
      "": "./",
      "app\\": "./app",
      "App\\": "./app",
      "app\\View\\Components\\": "./app/view/components"
    }
  },
  "prefer-stable": true,
  "repositories": [
    {
      "type": "path",
      "url": "../..",
      "options": {
        "symlink": true,
        "versions": {
          "z0x/webman-starter": "dev-local"
        }
      }
    }
  ],
  "extra": {
    "upstream-skeleton": {
      "package": "workerman/webman",
      "url": "https://github.com/walkor/webman",
      "tag": "v2.2.3",
      "commit": "394e611efc496eab992fc6447d2c7ef2438b6902"
    }
  }
}
